---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="page-header">
	<div class="container">
		<h1 class="reveal">{title}</h1>
	</div>
</div>

<style>
	.page-header {
		color: var(--text-on-accent);
		padding-block: 6rem 3rem; /* extra top padding clears the fixed header */
		text-align: center;
	}

	.page-header h1 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.01em;
	}
</style>
