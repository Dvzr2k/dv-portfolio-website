---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="projects" class="container">
	<h2 class="reveal">{t('home.projects.heading')}</h2>
	<div class="projects-grid">
		{projects.map((project, i) => <ProjectCard project={project} delay={0.15 + i * 0.1} />)}
	</div>
	<a
		href={localizePath('/projects', lang)}
		class="reveal btn btn-primary see-all"
		style={`--reveal-delay: ${(0.15 + projects.length * 0.1).toFixed(2)}s`}
	>
		{t('home.projects.cta')} →
	</a>
</section>

<style>
	h2 {
		color: var(--text-on-dark);
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-bottom: 3rem;
		text-align: center;
	}

	h2::before {
		content: '# ';
		color: var(--accent-2);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 1.5rem;
	}

	.see-all {
		display: block;
		width: fit-content;
		margin-inline: auto;
		margin-top: 2rem;
	}
</style>
