---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// current path with the active locale prefix stripped, so we can rebuild it for the other language
const rawPath = Astro.url.pathname.replace(/^\/es/, '') || '/';

const navItems = [
	{ path: '/about', label: t('nav.about') },
	{ path: '/projects', label: t('nav.projects') },
	{ path: '/contact', label: t('nav.contact') },
];
---

<header class="site-header">
	<div class="container header-inner">
		<a href={localizePath('/', lang)} class="logo">Diego Valdez</a>

		<nav aria-label="Main">
			{
				navItems.map((item) => (
					<a href={localizePath(item.path, lang)} class:list={{ active: rawPath === item.path }}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="lang-switch" role="group" aria-label="Language">
			{
				Object.entries(languages).map(([code]) => (
					<a
						href={localizePath(rawPath, code as keyof typeof languages)}
						class:list={['lang-link', { active: code === lang }]}
					>
						{code.toUpperCase()}
					</a>
				))
			}
		</div>
	</div>
</header>

<script>
	// Background stays transparent always — only the text color flips, once
	// scrolled past the point where the body gradient (global.css --gradient)
	// has settled into its dark landing tone, matching that gradient's own
	// 55vh anchor so the two stay in sync without measuring any element.
	const header = document.querySelector('.site-header');

	function updateHeaderState() {
		if (!header) return;
		header.classList.toggle('on-dark', window.scrollY > window.innerHeight * 0.5);
	}

	updateHeaderState();
	document.addEventListener('scroll', updateHeaderState, { passive: true });
</script>

<style>
	.site-header {
		/* fixed, not sticky — sticky still occupies its own row in the layout
		   (so "transparent" only ever revealed the plain page bg behind it).
		   fixed takes it out of flow entirely so it overlaps the body's
		   gradient, which now runs the full page — background stays fully
		   transparent always, no border/tint of its own that would read as
		   a separate block; only the text color adapts. */
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		background: transparent;
		color: var(--text-on-accent);
		z-index: 20;
		transition: color 0.25s ease;
	}

	.site-header.on-dark {
		color: var(--text-on-dark);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1rem;
	}

	.logo {
		font-weight: 700;
		font-size: 1.1rem;
		text-decoration: none;
		color: inherit;
	}

	nav {
		display: flex;
		gap: 1.5rem;
	}

	nav a {
		text-decoration: none;
		color: inherit;
		opacity: 0.75;
		font-weight: 500;
	}

	nav a:hover {
		opacity: 1;
	}

	nav a.active {
		opacity: 1;
		font-weight: 700;
	}

	.lang-switch {
		display: flex;
		gap: 0.5rem;
		font-size: 0.8rem;
	}

	.lang-link {
		text-decoration: none;
		color: inherit;
		opacity: 0.75;
		padding: 0.25rem 0.5rem;
		border-radius: 0.35rem;
	}

	.lang-link.active {
		opacity: 1;
		color: var(--text-on-accent);
		background: var(--accent-3);
		font-weight: 700;
	}
</style>
