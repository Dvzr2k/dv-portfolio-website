---
import type { Project } from '../data/projects';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

interface Props {
	project: Project;
	delay?: number;
}

const { project, delay = 0 } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<article class="project-card reveal" style={`--reveal-delay: ${delay}s`}>
	<div class="status-row">
		<span class="dot" aria-hidden="true"></span> {project.status}
	</div>
	<h3 class="path"><span class="prefix">~/</span>{project.slug}</h3>
	<p class="description">{project.description[lang]}</p>
	<div class="stack"><span class="k">stack:</span> <span class="v">{project.tech.join(' · ')}</span></div>
	<div class="card-links">
		<a href={localizePath(`/projects/${project.slug}`, lang)} class="card-link primary">
			{t('project.viewDetails')}
		</a>
		<a href={project.github} target="_blank" rel="noopener noreferrer" class="card-link">
			{t('project.viewSource')}
		</a>
	</div>
</article>

<style>
	.project-card {
		/* GitHub Actions' own dark-theme surface colors, matching Hero's
		   .gha-card — same palette so the hero and the cards read as one
		   consistent visual system instead of two different treatments */
		--gh-bg: #0d1117;
		--gh-border: #30363d;
		--gh-heading: #c9d1d9;
		--gh-muted: #8b949e;

		background: var(--gh-bg);
		border: 1px solid var(--gh-border);
		border-radius: 0.6rem;
		padding: 1.4rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.project-card:hover {
		border-color: var(--accent-2);
		transform: translateY(-4px);
	}

	.status-row {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-2);
	}

	.status-row .dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--accent-2);
		box-shadow: 0 0 6px var(--accent-2);
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.4;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.status-row .dot {
			animation: none;
		}
	}

	.path {
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--gh-heading);
	}

	.path .prefix {
		font-weight: 400;
		color: var(--gh-muted);
	}

	.description {
		color: var(--gh-muted);
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.stack {
		font-size: 0.78rem;
		color: var(--gh-muted);
		padding-top: 0.7rem;
		border-top: 1px dashed var(--gh-border);
	}

	.stack .k {
		color: var(--accent-1);
	}

	.stack .v {
		color: var(--gh-heading);
	}

	.card-links {
		margin-top: 0.2rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
	}

	.card-link {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--gh-muted);
		text-decoration: none;
	}

	.card-link.primary {
		color: var(--accent-2);
	}

	.card-link:hover {
		text-decoration: underline;
	}
</style>
