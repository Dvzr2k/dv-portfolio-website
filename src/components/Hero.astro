---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import photo from '../assets/photo.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
	<div class="gha-card reveal" style="--reveal-delay: 0s" data-pipeline>
		<div class="gha-header">
			<Image src={photo} alt="Diego Valdez" width={112} height={112} class="avatar" />
			<div>
				<div class="gha-title">intro.yml #1 · whoami</div>
				<div class="gha-meta">workflow_dispatch · main · <span data-elapsed>0.00s</span></div>
			</div>
		</div>

		<div class="gha-steps">
			<div class="gha-step pending" data-step="1">
				<div class="gha-step-head">
					<span class="gha-chevron" aria-hidden="true">▾</span>
					<span class="gha-icon">
						<span class="gha-spinner" aria-hidden="true"></span>
						<svg
							class="gha-check"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</span>
					<span class="gha-step-name">Run whoami</span>
					<span class="gha-step-time">0.02s</span>
				</div>
				<div class="gha-step-log">Diego Valdez — {t('hero.headline')}</div>
			</div>

			<div class="gha-step pending" data-step="2">
				<div class="gha-step-head">
					<span class="gha-chevron" aria-hidden="true">▾</span>
					<span class="gha-icon">
						<span class="gha-spinner" aria-hidden="true"></span>
						<svg
							class="gha-check"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</span>
					<span class="gha-step-name">Run cat motd</span>
					<span class="gha-step-time">0.01s</span>
				</div>
				<div class="gha-step-log">{t('hero.tagline')}</div>
			</div>
		</div>

		<div class="gha-footer">
			<span class="pulse" aria-hidden="true"></span> All jobs passed
		</div>
	</div>

	<a href="#projects" class="scroll-cue" aria-label="Scroll to projects">
		<svg
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<polyline points="6 9 12 15 18 9"></polyline>
		</svg>
	</a>
</section>

<script>
	// Simulates the pipeline actually running on load: steps resolve from a
	// spinner to a checkmark in sequence, with a live-ticking elapsed timer
	// in the header, ending with the footer flourish once both are done.
	// Purely cosmetic/scripted (not a real process), so the timeline is a
	// fixed schedule rather than measuring anything real.
	const STEP_TIMES = [520, 1080]; // ms — when each step resolves
	const FOOTER_DELAY = 1080;

	function runPipeline(card: HTMLElement) {
		const elapsedEl = card.querySelector<HTMLElement>('[data-elapsed]');
		const steps = card.querySelectorAll<HTMLElement>('[data-step]');

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (reducedMotion) {
			steps.forEach((step) => step.classList.replace('pending', 'done'));
			card.classList.add('finished');
			if (elapsedEl) elapsedEl.textContent = `${(FOOTER_DELAY / 1000).toFixed(2)}s`;
			return;
		}

		const start = performance.now();
		let frame: number;

		function tick(now: number) {
			if (!elapsedEl) return;
			const elapsed = now - start;
			if (elapsed >= FOOTER_DELAY) {
				elapsedEl.textContent = `${(FOOTER_DELAY / 1000).toFixed(2)}s`;
				return;
			}
			elapsedEl.textContent = `${(elapsed / 1000).toFixed(2)}s`;
			frame = requestAnimationFrame(tick);
		}
		frame = requestAnimationFrame(tick);

		steps.forEach((step, i) => {
			setTimeout(() => step.classList.replace('pending', 'done'), STEP_TIMES[i]);
		});

		setTimeout(() => {
			cancelAnimationFrame(frame);
			card.classList.add('finished');
		}, FOOTER_DELAY);
	}

	document.querySelectorAll<HTMLElement>('[data-pipeline]').forEach(runPipeline);
</script>

<style>
	.hero {
		/* background intentionally not set here — body's gradient (global.css
		   --gradient) shows through, running continuously through Hero and
		   the rest of the page instead of resetting per-section */
		position: relative;
		color: var(--text-on-accent);
		/* fills the viewport so "A few things I've built" starts below the
		   fold — invisible (and un-triggered) until the user actually scrolls,
		   instead of both being visible-and-revealed at once on load */
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block: 5rem 3rem; /* extra top padding clears the fixed header */
	}

	/* GitHub Actions' own dark-theme surface colors, kept as-is for
	   authenticity — only the success/accent color is the site's own lime
	   instead of GitHub's green */
	.gha-card {
		--gh-bg: #0d1117;
		--gh-border: #30363d;
		--gh-heading: #c9d1d9;
		--gh-muted: #8b949e;

		width: min(58rem, 94vw);
		border-radius: 0.6rem;
		overflow: hidden;
		background: var(--gh-bg);
		border: 1px solid var(--gh-border);
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.55);
		text-align: left;
	}

	.gha-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.5rem 1.75rem;
		border-bottom: 1px solid var(--gh-border);
	}

	.avatar {
		flex: none;
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--accent-2);
	}

	.gha-title {
		color: var(--gh-heading);
		font-weight: 600;
		font-size: 1.15rem;
	}

	.gha-meta {
		color: var(--gh-muted);
		font-size: 0.88rem;
		margin-top: 0.25rem;
		font-variant-numeric: tabular-nums;
	}

	.gha-steps {
		padding: 0.5rem 0;
	}

	.gha-step {
		padding: 0.9rem 1.75rem;
	}

	.gha-step-head {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.gha-chevron {
		color: var(--gh-muted);
		font-size: 0.8rem;
		width: 0.9rem;
	}

	.gha-icon {
		position: relative;
		flex: none;
		width: 1.15rem;
		height: 1.15rem;
	}

	.gha-spinner {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid color-mix(in srgb, var(--gh-muted) 35%, transparent);
		border-top-color: var(--accent-1);
		animation: spin 0.7s linear infinite;
		opacity: 1;
		transition: opacity 0.2s ease;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.gha-check {
		position: absolute;
		inset: 0;
		color: var(--accent-2);
		opacity: 0;
		transform: scale(0.6);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.gha-step.done .gha-spinner {
		opacity: 0;
	}

	.gha-step.done .gha-check {
		opacity: 1;
		transform: scale(1);
	}

	.gha-step-name {
		color: var(--gh-heading);
		font-size: 1.02rem;
	}

	.gha-step-time {
		margin-left: auto;
		color: var(--gh-muted);
		font-size: 0.85rem;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.gha-step.done .gha-step-time {
		opacity: 1;
	}

	.gha-step-log {
		margin: 0.6rem 0 0 1.8rem;
		padding-left: 1rem;
		border-left: 2px solid var(--gh-border);
		color: var(--gh-muted);
		font-size: 0.95rem;
		line-height: 1.65;
		opacity: 0;
		transform: translateY(0.4rem);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}

	.gha-step.done .gha-step-log {
		opacity: 1;
		transform: translateY(0);
	}

	.gha-footer {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 1.1rem 1.75rem;
		border-top: 1px solid var(--gh-border);
		color: var(--accent-2);
		font-size: 0.98rem;
		font-weight: 600;
		opacity: 0;
		transform: translateY(0.3rem);
		transition:
			opacity 0.4s ease,
			transform 0.4s ease;
	}

	.gha-card.finished .gha-footer {
		opacity: 1;
		transform: translateY(0);
	}

	.gha-footer .pulse {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--accent-2);
		box-shadow: 0 0 8px var(--accent-2);
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.4;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gha-footer .pulse {
			animation: none;
		}

		.gha-spinner {
			animation: none;
		}

		.gha-step-time,
		.gha-step-log,
		.gha-footer {
			transition: none;
		}
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 2rem;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--text-on-dark) 45%, transparent);
		color: var(--text-on-dark);
		opacity: 0.85;
		animation: bounce 1.8s ease-in-out infinite;
	}

	.scroll-cue svg {
		width: 1.75rem;
		height: 1.75rem;
	}

	.scroll-cue:hover {
		opacity: 1;
		border-color: color-mix(in srgb, var(--text-on-dark) 70%, transparent);
	}

	@keyframes bounce {
		0%,
		100% {
			transform: translateX(-50%) translateY(0);
		}
		50% {
			transform: translateX(-50%) translateY(0.4rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-cue {
			animation: none;
		}
	}
</style>
